[Unit]
Description=YW Studio API (health, share links)
After=network-online.target
Wants=network-online.target

[Service]
User=yw
Group=yw
EnvironmentFile=/etc/yw/yw.env
WorkingDirectory=/opt/yw/app
ExecStart=/usr/bin/python3 -s /opt/yw/app/yw_api.py
Restart=always
RestartSec=3
MemoryMax=768M
TasksMax=64
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
ReadWritePaths=/var/lib/yw
UMask=0077

[Install]
WantedBy=multi-user.target
