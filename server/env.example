# /etc/yw/yw.env — created by setup.sh on the server only (chmod 600, root). Never commit the real file.
# YW_SALT is generated by setup.sh (random, salts the in-memory rate-limit keys).
YW_SALT=
YW_DATA_DIR=/var/lib/yw
YW_PUBLIC_URL=https://api.yolo.su
YW_RELAY_PUBLIC_URL=wss://relay.yolo.su
# Share links (Online Sessions P1)
YW_SHARE_MAX_BYTES=2147483648
YW_SHARE_DEFAULT_DAYS=7
YW_SHARE_MAX_DAYS=30
YW_SHARE_TOTAL_BYTES=64424509440
YW_SHARE_CLIENT_DAILY_BYTES=8589934592
YW_SHARE_CREATES_PER_HOUR=20
YW_SHARE_INCOMPLETE_HOURS=24
YW_MIN_FREE_BYTES=10737418240
# Relay (Online Sessions P2/P4 skeleton)
YW_RELAY_MAX_PEERS=4
YW_RELAY_MAX_ROOMS=200
YW_RELAY_ROOM_HOURS=12
YW_RELAY_MAX_FRAME=1048576
YW_RELAY_PEER_BPS=4194304
YW_RELAY_ROOMS_PER_HOUR=10
# abuse limits (round 190ah): bytes a room relays in all / a client sends per 24 h, rooms open per client, room life
YW_RELAY_ROOM_BYTES=12884901888
YW_RELAY_CLIENT_BYTES_DAY=34359738368
YW_RELAY_ROOMS_PER_CLIENT=8
YW_RELAY_ROOM_MAX_HOURS=72
YW_RELAY_ROOM_IDLE_HOURS=12
