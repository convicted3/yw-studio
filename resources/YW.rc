#include <winuser.h>
#include <winver.h>
// yw_version.h is generated by scripts/build-windows-zig.sh from project(YW VERSION ...) in CMakeLists.txt
#include "yw_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "YW.manifest"
1 ICON "YW.ico"
2 ICON "YW_doc.ico"

1 VERSIONINFO
 FILEVERSION    YW_VERSION_MAJOR, YW_VERSION_MINOR, YW_VERSION_PATCH, 0
 PRODUCTVERSION YW_VERSION_MAJOR, YW_VERSION_MINOR, YW_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "YW"
            VALUE "FileDescription",  "YW Studio digital audio workstation"
            VALUE "FileVersion",      YW_VERSION_STR
            VALUE "InternalName",     "YW Studio"
            VALUE "LegalCopyright",   "YW Studio (yolo.su). Based on LYNX SHARE (C) 2026 Ka1-S. GNU AGPL-3.0."
            VALUE "OriginalFilename", "YW Studio.exe"
            VALUE "ProductName",      "YW Studio"
            VALUE "ProductVersion",   YW_VERSION_STR
            VALUE "Comments",         "https://github.com/convicted3/yw-studio"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
