<?xml version="1.0" encoding="utf-8"?>
<!--
  YW Studio's MSIX package manifest for the Microsoft Store (round 165n, docs/STORE.md).
  scripts/make-msix-layout.py fills the @...@ fields: the identity comes from Partner Center (Product identity page),
  through the repository variables MSIX_IDENTITY_NAME, MSIX_PUBLISHER and MSIX_PUBLISHER_DISPLAY, and the display
  Store name (Properties/DisplayName) must be the name reserved there (MSIX_DISPLAY_NAME, default "YW Studio":
  "YW" was taken). Since v0.1.20 the product is YW Studio everywhere: Start menu, taskbar and the app say it too
  (VisualElements DisplayName / ShortName); the Application Id, YW.exe and the data folders keep "YW".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Free, open-source digital audio workstation with a pattern-based workflow.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- the Visual C++ runtime of onnxruntime.dll (Extract stems from sample): a Microsoft framework package the Store
         installs with YW, so nothing proprietary is shipped in YW's own package -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.30704.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
    <Resource Language="es-es" />
    <Resource Language="fr-fr" />
    <Resource Language="de-de" />
    <Resource Language="it-it" />
    <Resource Language="nl-nl" />
    <Resource Language="pl-pl" />
    <Resource Language="ru-ru" />
    <Resource Language="tr-tr" />
    <Resource Language="id-id" />
    <Resource Language="ja-jp" />
    <Resource Language="ko-kr" />
    <Resource Language="zh-cn" />
    <Resource Language="zh-tw" />
  </Resources>

  <Applications>
    <Application Id="YW" Executable="YW.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="YW Studio" Description="Free, open-source digital audio workstation"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" ShortName="YW Studio" />
      </uap:VisualElements>
      <Extensions>
        <!-- `yw` on the command line (and the release workflow's packaged self-test) -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="YW.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="yw.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- YW projects; FL Studio projects and MIDI files are only offered in "Open with" (Windows keeps the
             current default program) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="ywproject">
            <uap:DisplayName>YW Studio Project</uap:DisplayName>
            <uap:Logo>Assets\ProjectFile.png</uap:Logo>
            <uap:InfoTip>YW project</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-yw-project">.yw</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="flproject">
            <uap:DisplayName>FL Studio project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.flp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="midifile">
            <uap:DisplayName>MIDI file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="audio/midi">.mid</uap:FileType>
              <uap:FileType ContentType="audio/midi">.midi</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- recording from a microphone / audio interface (Windows asks the user once) -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
